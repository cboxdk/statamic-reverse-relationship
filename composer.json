{
    "name": "cboxdk/statamic-reverse-relationship",
    "description": "Traverse relationships in reverse — see which entries, terms, or assets reference the current item without storing anything on it.",
    "license": "MIT",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "addon",
        "relationship",
        "reverse",
        "entries",
        "fieldtype"
    ],
    "authors": [
        {
            "name": "Sylvester Damgaard",
            "homepage": "https://github.com/cboxdk"
        }
    ],
    "homepage": "https://github.com/cboxdk/statamic-reverse-relationship",
    "support": {
        "issues": "https://github.com/cboxdk/statamic-reverse-relationship/issues"
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "conflict": {
        "tv2regionerne/statamic-reverse-relationship": "*"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\ReverseRelationship\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\ReverseRelationship\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Reverse Relationship",
            "description": "Traverse relationships in reverse — see which entries, terms, or assets reference the current item."
        },
        "laravel": {
            "providers": [
                "Cbox\\ReverseRelationship\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "lint": "./vendor/bin/pint --test",
        "fix": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": false
        }
    }
}
